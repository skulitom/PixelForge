{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PixelForge scene review",
  "type": "object",
  "properties": {
    "format": {
      "const": "pixelforge-scene"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
      "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "background": {
      "type": "string",
      "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
    },
    "duration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    },
    "assets": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "oneOf": [
          {
            "oneOf": [
              {
                "$ref": "#/$defs/recipe"
              },
              {
                "type": "string",
                "description": "Recipe file, resolved by the CLI relative to the scene or inside the MCP root."
              },
              {
                "type": "object",
                "properties": {
                  "revision": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{12}$"
                  }
                },
                "required": [
                  "revision"
                ],
                "additionalProperties": false
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "recipe": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/recipe"
                  },
                  {
                    "type": "string",
                    "description": "Recipe file, resolved by the CLI relative to the scene or inside the MCP root."
                  },
                  {
                    "type": "object",
                    "properties": {
                      "revision": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{12}$"
                      }
                    },
                    "required": [
                      "revision"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "normal": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/recipe"
                  },
                  {
                    "type": "string",
                    "description": "Recipe file, resolved by the CLI relative to the scene or inside the MCP root."
                  },
                  {
                    "type": "object",
                    "properties": {
                      "revision": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{12}$"
                      }
                    },
                    "required": [
                      "revision"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "emissive": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/recipe"
                  },
                  {
                    "type": "string",
                    "description": "Recipe file, resolved by the CLI relative to the scene or inside the MCP root."
                  },
                  {
                    "type": "object",
                    "properties": {
                      "revision": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{12}$"
                      }
                    },
                    "required": [
                      "revision"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "recipe"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "asset": {
            "type": "string"
          },
          "at": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "maxItems": 2,
            "minItems": 2,
            "description": "[x, y] in unscaled canvas pixels; the top-left corner of that pixel."
          },
          "anchor": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "maxItems": 2,
            "minItems": 2,
            "description": "[x, y] in unscaled canvas pixels; the top-left corner of that pixel."
          },
          "scale": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "frame": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
            "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
          },
          "animation": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
            "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
          },
          "repeat": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "maxItems": 2,
            "minItems": 2
          },
          "step": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "maxItems": 2,
            "minItems": 2,
            "description": "[x, y] in unscaled canvas pixels; the top-left corner of that pixel."
          },
          "trajectory": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "time": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 60000
                },
                "at": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": -4096,
                    "maximum": 4096
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "description": "[x, y] in unscaled canvas pixels; the top-left corner of that pixel."
                }
              },
              "required": [
                "time",
                "at"
              ],
              "additionalProperties": false
            },
            "maxItems": 256,
            "minItems": 2
          },
          "sequence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "time": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 59999
                },
                "frame": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                  "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
                },
                "animation": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                  "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
                }
              },
              "required": [
                "time"
              ],
              "additionalProperties": false
            },
            "maxItems": 64
          },
          "tilemap": {
            "type": "object",
            "properties": {
              "tile": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": -4096,
                  "maximum": 4096
                },
                "maxItems": 2,
                "minItems": 2,
                "description": "[x, y] in unscaled canvas pixels; the top-left corner of that pixel."
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "maxItems": 256,
                "minItems": 1
              },
              "legend": {
                "type": "object",
                "propertyNames": {
                  "minLength": 1,
                  "maxLength": 1
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string",
                      "description": "Frame name."
                    },
                    {
                      "type": "object",
                      "properties": {
                        "frame": {
                          "type": "string"
                        },
                        "frames": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "maxItems": 64
                        },
                        "animation": {
                          "type": "string"
                        },
                        "animations": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "maxItems": 64
                        },
                        "autotile": {
                          "enum": [
                            "blob",
                            "cardinal"
                          ],
                          "description": "Substitute {mask} in the names with the 47-value blob or 16-value cardinal neighbour mask."
                        },
                        "match": {
                          "type": "string",
                          "description": "Characters counted as the same terrain; default: this character."
                        }
                      },
                      "required": [],
                      "additionalProperties": false
                    },
                    {
                      "type": "null",
                      "description": "Context cell: never drawn, but other entries can match it (for example terrain just outside a reviewed window of a larger map)."
                    }
                  ]
                }
              },
              "outside": {
                "enum": [
                  "empty",
                  "match"
                ]
              }
            },
            "required": [
              "rows",
              "legend"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "asset",
          "at"
        ],
        "additionalProperties": false
      },
      "maxItems": 256
    },
    "lighting": {
      "type": "object",
      "properties": {
        "ambient": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bands": {
          "type": "integer",
          "minimum": 2,
          "maximum": 16
        },
        "scope": {
          "enum": [
            "passes",
            "all"
          ],
          "description": "passes (default) lights only assets with normal/emissive passes; all also lights plain assets as flat surfaces."
        },
        "lights": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": -4096,
                  "maximum": 4096
                },
                "maxItems": 2,
                "minItems": 2,
                "description": "[x, y] in unscaled canvas pixels; the top-left corner of that pixel."
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 256
              },
              "radius": {
                "type": "integer",
                "minimum": 1,
                "maximum": 512
              },
              "color": {
                "type": "string",
                "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
              }
            },
            "required": [
              "at"
            ],
            "additionalProperties": false
          },
          "maxItems": 8
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "version",
    "name",
    "width",
    "height",
    "assets",
    "instances"
  ],
  "additionalProperties": false,
  "$defs": {
    "rows": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 256,
      "minItems": 1,
      "description": "Equal-width text rows. Every character is a palette key; dot and space skip a pixel."
    },
    "frame": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
        },
        "duration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000,
          "description": "Frame duration in milliseconds; default 100."
        },
        "from": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
        },
        "translate": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -4096,
            "maximum": 4096
          },
          "maxItems": 2,
          "minItems": 2
        },
        "wrap": {
          "type": "boolean",
          "description": "Translation wraps around the canvas instead of clipping (scrolling tiles)."
        },
        "flipX": {
          "type": "boolean"
        },
        "flipY": {
          "type": "boolean"
        },
        "palette": {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": {
            "type": "string",
            "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
          },
          "description": "Recolor project palette keys for this frame only (palette cycling). Keys must exist in the project palette."
        },
        "anchor": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -4096,
            "maximum": 4096
          },
          "maxItems": 2,
          "minItems": 2,
          "description": "[x, y] in unscaled canvas pixels; the top-left corner of that pixel."
        },
        "points": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
            "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "maxItems": 2,
            "minItems": 2,
            "description": "[x, y] in unscaled canvas pixels; the top-left corner of that pixel."
          },
          "description": "Named frame positions (hands, hit points, glyph advance), exported in the atlas in exported pixels."
        },
        "ops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/op"
          },
          "maxItems": 2048
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          },
          "maxItems": 64
        },
        "pixels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pixel"
          },
          "maxItems": 65536,
          "description": "Final canvas-coordinate RGBA replacements after ops and layers. Coordinates must be inside this canvas. Later entries win; transparent erases."
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "pixel": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "color": {
          "type": "string",
          "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
        }
      },
      "required": [
        "x",
        "y",
        "color"
      ],
      "additionalProperties": false
    },
    "layer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
        },
        "visible": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "x": {
          "type": "integer",
          "minimum": -4096,
          "maximum": 4096
        },
        "y": {
          "type": "integer",
          "minimum": -4096,
          "maximum": 4096
        },
        "ops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/op"
          },
          "maxItems": 2048
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "op": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "pixel"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "color": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            }
          },
          "required": [
            "op",
            "color"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "rect"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "color": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            },
            "filled": {
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "w",
            "h",
            "color"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "ellipse"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "color": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            },
            "filled": {
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "w",
            "h",
            "color"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "line"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "x2": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y2": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "color": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            }
          },
          "required": [
            "op",
            "x2",
            "y2",
            "color"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "clear"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            }
          },
          "required": [
            "op",
            "w",
            "h"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "fill"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "color": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            }
          },
          "required": [
            "op",
            "color"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "replace"
            },
            "from": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            },
            "to": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            }
          },
          "required": [
            "op",
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "grid"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "rows": {
              "$ref": "#/$defs/rows"
            },
            "scale": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "flipX": {
              "type": "boolean"
            },
            "flipY": {
              "type": "boolean"
            },
            "rotate": {
              "enum": [
                0,
                90,
                180,
                270
              ]
            },
            "remap": {
              "type": "object",
              "propertyNames": {
                "minLength": 1,
                "maxLength": 1
              },
              "additionalProperties": {
                "type": "string",
                "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
              },
              "description": "Recolor grid characters for this operation only: character → palette name or colour."
            }
          },
          "required": [
            "op",
            "rows"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "stamp"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "symbol": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
              "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
            },
            "scale": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "flipX": {
              "type": "boolean"
            },
            "flipY": {
              "type": "boolean"
            },
            "rotate": {
              "enum": [
                0,
                90,
                180,
                270
              ]
            },
            "remap": {
              "type": "object",
              "propertyNames": {
                "minLength": 1,
                "maxLength": 1
              },
              "additionalProperties": {
                "type": "string",
                "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
              },
              "description": "Recolor grid characters for this operation only: character → palette name or colour."
            }
          },
          "required": [
            "op",
