{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PixelForge autotile template",
  "description": "A template two tiles wide and three tall: row 0 holds an unused preview tile and an inner-corner tile; rows 1–2 hold a 2×2-tile island whose quadrants give outer corners, edges and fill. Compiles to a recipe whose frames copy four quarters each.",
  "type": "object",
  "properties": {
    "format": {
      "const": "pixelforge-autotile"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
      "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
    },
    "tile": {
      "type": "integer",
      "minimum": 2,
      "maximum": 128,
      "description": "Even tile size in pixels."
    },
    "mode": {
      "enum": [
        "blob",
        "cardinal"
      ]
    },
    "palette": {
      "type": "object",
      "maxProperties": 257,
      "properties": {
        "$ref": {
          "type": "string",
          "description": "Shared palette file, resolved by the CLI and MCP relative to this recipe. Local entries add to or override it."
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(transparent|#([a-fA-F0-9]{3,4}|[a-fA-F0-9]{6}|[a-fA-F0-9]{8}))$"
      }
    },
    "template": {
      "$ref": "#/$defs/rows",
      "description": "tile × 3 rows of tile × 2 characters."
    },
    "frame": {
      "type": "string",
      "pattern": "\\{mask\\}",
      "description": "Frame name template; {mask} is the neighbour mask and {variant} the variant name."
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,16}$"
          },
          "duration": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000
          },
          "palette": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            }
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "maxItems": 16,
      "minItems": 1
    },
    "animation": {
      "type": "string",
      "pattern": "\\{mask\\}",
      "description": "Optional per-mask animation over the variants, in order."
    },
    "sheet": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "padding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "scale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "trim": {
          "type": "boolean",
          "description": "Pack each frame by its visible bounds; the atlas reports trimmed rectangles with spriteSourceSize. Ignores columns."
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "version",
    "name",
    "tile",
    "template",
    "frame"
  ],
  "additionalProperties": false,
  "$defs": {
    "rows": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 256,
      "minItems": 1,
      "description": "Equal-width text rows. Every character is a palette key; dot and space skip a pixel."
    },
    "frame": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
        },
        "duration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000,
          "description": "Frame duration in milliseconds; default 100."
        },
        "from": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
        },
        "translate": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -4096,
            "maximum": 4096
          },
          "maxItems": 2,
          "minItems": 2
        },
        "wrap": {
          "type": "boolean",
          "description": "Translation wraps around the canvas instead of clipping (scrolling tiles)."
        },
        "flipX": {
          "type": "boolean"
        },
        "flipY": {
          "type": "boolean"
        },
        "palette": {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": {
            "type": "string",
            "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
          },
          "description": "Recolor project palette keys for this frame only (palette cycling). Keys must exist in the project palette."
        },
        "anchor": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -4096,
            "maximum": 4096
          },
          "maxItems": 2,
          "minItems": 2,
          "description": "[x, y] in unscaled canvas pixels; the top-left corner of that pixel."
        },
        "points": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
            "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "maxItems": 2,
            "minItems": 2,
            "description": "[x, y] in unscaled canvas pixels; the top-left corner of that pixel."
          },
          "description": "Named frame positions (hands, hit points, glyph advance), exported in the atlas in exported pixels."
        },
        "ops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/op"
          },
          "maxItems": 2048
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          },
          "maxItems": 64
        },
        "pixels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pixel"
          },
          "maxItems": 65536,
          "description": "Final canvas-coordinate RGBA replacements after ops and layers. Coordinates must be inside this canvas. Later entries win; transparent erases."
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "pixel": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "color": {
          "type": "string",
          "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
        }
      },
      "required": [
        "x",
        "y",
        "color"
      ],
      "additionalProperties": false
    },
    "layer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
        },
        "visible": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "x": {
          "type": "integer",
          "minimum": -4096,
          "maximum": 4096
        },
        "y": {
          "type": "integer",
          "minimum": -4096,
          "maximum": 4096
        },
        "ops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/op"
          },
          "maxItems": 2048
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "op": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "pixel"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "color": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            }
          },
          "required": [
            "op",
            "color"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "rect"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "color": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            },
            "filled": {
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "w",
            "h",
            "color"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "ellipse"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "color": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            },
            "filled": {
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "w",
            "h",
            "color"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "line"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "x2": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y2": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "color": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            }
          },
          "required": [
            "op",
            "x2",
            "y2",
            "color"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "clear"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            }
          },
          "required": [
            "op",
            "w",
            "h"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "fill"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "color": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            }
          },
          "required": [
            "op",
            "color"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "replace"
            },
            "from": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            },
            "to": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            }
          },
          "required": [
            "op",
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "grid"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "rows": {
              "$ref": "#/$defs/rows"
            },
            "scale": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "flipX": {
              "type": "boolean"
            },
            "flipY": {
              "type": "boolean"
            },
            "rotate": {
              "enum": [
                0,
                90,
                180,
                270
              ]
            },
            "remap": {
              "type": "object",
              "propertyNames": {
                "minLength": 1,
                "maxLength": 1
              },
              "additionalProperties": {
                "type": "string",
                "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
              },
              "description": "Recolor grid characters for this operation only: character → palette name or colour."
            }
          },
          "required": [
            "op",
            "rows"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "stamp"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "symbol": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
              "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
            },
            "scale": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "flipX": {
              "type": "boolean"
            },
            "flipY": {
              "type": "boolean"
            },
            "rotate": {
              "enum": [
                0,
                90,
                180,
                270
              ]
            },
            "remap": {
              "type": "object",
              "propertyNames": {
                "minLength": 1,
                "maxLength": 1
              },
              "additionalProperties": {
                "type": "string",
                "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
              },
              "description": "Recolor grid characters for this operation only: character → palette name or colour."
            }
          },
          "required": [
            "op",
            "symbol"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "copy"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "from": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
              "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
            },
            "symbol": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
              "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
            },
            "sx": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "sy": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "scale": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "flipX": {
              "type": "boolean"
            },
            "flipY": {
              "type": "boolean"
            },
            "rotate": {
              "enum": [
                0,
                90,
                180,
                270
              ]
            },
            "remap": {
              "type": "object",
              "propertyNames": {
                "minLength": 1,
                "maxLength": 1
              },
              "additionalProperties": {
                "type": "string",
                "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
              },
              "description": "Recolor grid characters for this operation only: character → palette name or colour."
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "from"
              ]
            },
            {
              "required": [
                "symbol"
              ]
            }
          ],
          "description": "Copy a rectangle of a symbol (palette characters) or an earlier frame (exact RGBA)."
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "outline"
            },
            "color": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            },
            "diagonal": {
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "color"
          ],
          "additionalProperties": false,
          "description": "Draw a 1px outline around every visible pixel in this buffer (frame or layer); diagonal also fills corners."
        }
      ]
    }
  }
}
