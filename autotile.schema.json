{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PixelForge autotile template",
  "description": "A template two tiles wide and three tall: row 0 holds an unused preview tile and an inner-corner tile; rows 1–2 hold a 2×2-tile island whose quadrants give outer corners, edges and fill. Compiles to a recipe whose frames copy four quarters each.",
  "type": "object",
  "properties": {
    "format": {
      "const": "pixelforge-autotile"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
      "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
    },
    "tile": {
      "type": "integer",
      "minimum": 2,
      "maximum": 128,
      "description": "Even tile size in pixels."
    },
    "mode": {
      "enum": [
        "blob",
        "cardinal"
      ]
    },
    "palette": {
      "type": "object",
      "maxProperties": 257,
      "properties": {
        "$ref": {
          "type": "string",
          "description": "Shared palette file, resolved by the CLI and MCP relative to this recipe. Local entries add to or override it."
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(transparent|#([a-fA-F0-9]{3,4}|[a-fA-F0-9]{6}|[a-fA-F0-9]{8}))$"
      }
    },
    "template": {
      "$ref": "#/$defs/rows",
      "description": "tile × 3 rows of tile × 2 characters."
    },
    "frame": {
      "type": "string",
      "pattern": "\\{mask\\}",
      "description": "Frame name template; {mask} is the neighbour mask and {variant} the variant name."
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,16}$"
          },
          "duration": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000
          },
          "palette": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            }
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "maxItems": 16,
      "minItems": 1
    },
    "animation": {
      "type": "string",
      "pattern": "\\{mask\\}",
      "description": "Optional per-mask animation over the variants, in order."
    },
    "sheet": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "padding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "scale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "trim": {
          "type": "boolean",
          "description": "Pack each frame by its visible bounds; the atlas reports trimmed rectangles with spriteSourceSize. Ignores columns."
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "version",
    "name",
    "tile",
    "template",
    "frame"
  ],
  "additionalProperties": false,
  "$defs": {
    "rows": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 256,
      "minItems": 1,
      "description": "Equal-width text rows. Every character is a palette key; dot and space skip a pixel."
    },
    "frame": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
        },
        "duration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000,
          "description": "Frame duration in milliseconds; default 100."
        },
        "from": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
        },
        "translate": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -4096,
            "maximum": 4096
          },
          "maxItems": 2,
          "minItems": 2
        },
        "wrap": {
          "type": "boolean",
          "description": "Translation wraps around the canvas instead of clipping (scrolling tiles)."
        },
        "flipX": {
          "type": "boolean"
        },
        "flipY": {
          "type": "boolean"
        },
        "palette": {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": {
            "type": "string",
            "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
          },
          "description": "Recolor project palette keys for this frame only (palette cycling). Keys must exist in the project palette."
        },
        "anchor": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -4096,
            "maximum": 4096
          },
          "maxItems": 2,
          "minItems": 2,
          "description": "[x, y] in unscaled canvas pixels; the top-left corner of that pixel."
        },
        "points": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
            "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "maxItems": 2,
            "minItems": 2,
            "description": "[x, y] in unscaled canvas pixels; the top-left corner of that pixel."
          },
          "description": "Named frame positions (hands, hit points, glyph advance), exported in the atlas in exported pixels."
        },
        "ops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/op"
          },
          "maxItems": 2048
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          },
          "maxItems": 64
        },
        "pixels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pixel"
          },
          "maxItems": 65536,
          "description": "Final canvas-coordinate RGBA replacements after ops and layers. Coordinates must be inside this canvas. Later entries win; transparent erases."
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "pixel": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "color": {
          "type": "string",
          "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
        }
      },
      "required": [
        "x",
        "y",
        "color"
      ],
      "additionalProperties": false
    },
    "layer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
        },
        "visible": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "x": {
          "type": "integer",
          "minimum": -4096,
          "maximum": 4096
        },
        "y": {
          "type": "integer",
          "minimum": -4096,
          "maximum": 4096
        },
        "ops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/op"
          },
          "maxItems": 2048
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "op": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "pixel"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "color": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            }
          },
          "required": [
            "op",
            "color"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "rect"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "color": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            },
            "filled": {
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "w",
            "h",
            "color"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "ellipse"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "color": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            },
            "filled": {
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "w",
            "h",
            "color"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "line"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "x2": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y2": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "color": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            }
          },
          "required": [
            "op",
            "x2",
            "y2",
            "color"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "clear"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            }
          },
          "required": [
            "op",
            "w",
            "h"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "fill"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "color": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            }
          },
          "required": [
            "op",
            "color"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "replace"
            },
            "from": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            },
            "to": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            }
          },
          "required": [
            "op",
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "grid"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "rows": {
              "$ref": "#/$defs/rows"
            },
            "scale": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "flipX": {
              "type": "boolean"
            },
            "flipY": {
              "type": "boolean"
            },
            "rotate": {
              "enum": [
                0,
                90,
                180,
                270
              ]
            },
            "remap": {
              "type": "object",
              "propertyNames": {
                "minLength": 1,
                "maxLength": 1
              },
              "additionalProperties": {
                "type": "string",
                "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
              },
              "description": "Recolor grid characters for this operation only: character → palette name or colour."
            }
          },
          "required": [
            "op",
            "rows"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "stamp"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "symbol": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
              "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
            },
            "scale": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "flipX": {
              "type": "boolean"
            },
            "flipY": {
              "type": "boolean"
            },
            "rotate": {
              "enum": [
                0,
                90,
                180,
                270
              ]
            },
            "remap": {
              "type": "object",
              "propertyNames": {
                "minLength": 1,
                "maxLength": 1
              },
              "additionalProperties": {
                "type": "string",
                "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
              },
              "description": "Recolor grid characters for this operation only: character → palette name or colour."
            }
          },
          "required": [
            "op",
            "symbol"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "text"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "Printable ASCII; \\n starts a new line (at most 64)."
            },
            "color": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ],
              "description": "What x is: the left edge of the text (default), its centre or its right edge. Lines align the same way."
            },
            "spacing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16,
              "description": "Pixels between glyphs; default 1."
            },
            "lineHeight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "description": "Pixels from the top of one line to the top of the next; default 10."
            },
            "scale": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "flipX": {
              "type": "boolean"
            },
            "flipY": {
              "type": "boolean"
            },
            "rotate": {
              "enum": [
                0,
                90,
                180,
                270
              ]
            }
          },
          "required": [
            "op",
            "text",
            "color"
          ],
          "additionalProperties": false,
          "description": "Draw text in the built-in pixel font. y is the top of the capitals; a line is 8 rows: capitals 7 tall, lowercase 5, descenders 1 below. Glyphs are 1 to 5 pixels wide, digits always 5, a space 3. One line of n average characters is about 6n pixels wide."
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "copy"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "from": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
              "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
            },
            "symbol": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
              "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
            },
            "sx": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "sy": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "scale": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "flipX": {
              "type": "boolean"
            },
            "flipY": {
              "type": "boolean"
            },
            "rotate": {
              "enum": [
                0,
                90,
                180,
                270
              ]
            },
            "remap": {
              "type": "object",
              "propertyNames": {
                "minLength": 1,
                "maxLength": 1
              },
              "additionalProperties": {
                "type": "string",
                "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
              },
              "description": "Recolor grid characters for this operation only: character → palette name or colour."
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "from"
              ]
            },
            {
              "required": [
                "symbol"
              ]
            }
          ],
          "description": "Copy a rectangle of a symbol (palette characters) or an earlier frame (exact RGBA)."
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "autotile"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "symbol": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
              "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
            },
            "mask": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "description": "Neighbour mask. Blob: N=1, NE=2, E=4, SE=8, S=16, SW=32, W=64, NW=128, reduced so a diagonal counts only with both of its sides. Cardinal: N=1, E=2, S=4, W=8."
            },
            "mode": {
              "enum": [
                "blob",
                "cardinal"
              ],
              "description": "blob (default) or cardinal."
            },
            "remap": {
              "type": "object",
              "propertyNames": {
                "minLength": 1,
                "maxLength": 1
              },
              "additionalProperties": {
                "type": "string",
                "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
              },
              "description": "Recolor grid characters for this operation only: character → palette name or colour."
            }
          },
          "required": [
            "op",
            "symbol",
            "mask"
          ],
          "additionalProperties": false,
          "description": "Draw one autotile tile from a template symbol two tiles wide and three tall: the four quarters the mask selects (see the autotile template format). The autotile compiler emits one per frame, so editing the template redraws every tile."
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "outline"
            },
            "color": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            },
            "diagonal": {
              "type": "boolean"
            },
            "position": {
              "enum": [
                "outside",
                "inside",
                "middle"
              ],
              "description": "outside (default) surrounds the visible pixels; inside recolors their edge pixels; middle splits the width, the odd pixel outside."
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "description": "Rings of pixels; default 1."
            },
            "directions": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[x.]{3}$"
              },
              "maxItems": 3,
              "minItems": 3,
              "description": "3×3 grid centred on a visible pixel, with a dot in the centre: x marks the sides that get the line, e.g. [\"...\", \"...\", \"..x\"] for a drop shadow or [\".x.\", \"...\", \"...\"] for a top rim. Replaces diagonal."
            }
          },
          "required": [
            "op",
            "color"
          ],
          "additionalProperties": false,
          "description": "Outline every visible pixel in this buffer (frame or layer): outside rings, inside edge rings or both, in chosen directions."
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "dither"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "color": {
              "type": "string",
              "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
            },
            "erase": {
              "type": "boolean",
              "description": "Clear the pattern pixels instead of drawing a color."
            },
            "density": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "maxItems": 2,
                  "minItems": 2
                }
              ],
              "description": "Share of pixels drawn, 0–1 (default 0.5), or [from, to] ramping along direction."
            },
            "direction": {
              "enum": [
                "down",
                "up",
                "right",
                "left",
                "radial"
              ],
              "description": "Ramp direction for a [from, to] density; radial runs from the centre to the edge."
            },
            "pattern": {
              "oneOf": [
                {
                  "enum": [
                    "bayer2",
                    "bayer4",
                    "bayer8"
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    },
                    "maxItems": 16,
                    "minItems": 1
                  },
                  "maxItems": 16,
                  "minItems": 1,
                  "description": "Rows of ranks from 0 to cells − 1; low ranks turn on first, and a highest rank n gives n + 1 levels, so [[0, 1], [1, 0]] is a checkerboard at 0.5."
                }
              ],
              "description": "bayer4 by default. Patterns follow canvas coordinates, so neighbouring areas line up."
            },
            "offset": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": -4096,
                "maximum": 4096
              },
              "maxItems": 2,
              "minItems": 2,
              "description": "Shift the pattern, for example to crawl it between frames."
            },
            "over": {
              "oneOf": [
                {
                  "type": "string",
                  "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
                  },
                  "maxItems": 64,
                  "minItems": 1
                }
              ],
              "description": "Only change pixels whose exact current color is listed (transparent included)."
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "color"
              ]
            },
            {
              "required": [
                "erase"
              ]
            }
          ],
          "description": "Ordered dither between the current pixels and color: draws (or erases) where a canvas-anchored threshold pattern is below the density. x/y default to 0 and w/h reach the canvas edge."
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "rewrite"
            },
            "x": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "match": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8
                    },
                    "maxItems": 8,
                    "minItems": 1,
                    "description": "Equal-width rows of palette keys; dot or space matches anything (match) or keeps the pixel (replace); the empty character stands for transparent."
                  },
                  "replace": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8
                    },
                    "maxItems": 8,
                    "minItems": 1,
                    "description": "Equal-width rows of palette keys; dot or space matches anything (match) or keeps the pixel (replace); the empty character stands for transparent."
                  }
                },
                "required": [
                  "match",
                  "replace"
                ],
                "additionalProperties": false
              },
              "maxItems": 16,
              "minItems": 1
            },
            "empty": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1,
              "description": "A non-palette character meaning a transparent pixel in match and erasure in replace."
            },
            "steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "description": "Passes over every rule; stops early when a pass changes nothing."
            },
            "chance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Seeded probability that each match is applied."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536,
              "description": "Most replacements per rule per step."
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "rotate": {
              "type": "boolean",
              "description": "Also match the rules turned 90°, 180° and 270°."
            },
            "mirror": {
              "type": "boolean",
              "description": "Also match the rules mirrored horizontally."
            }
          },
          "required": [
            "op",
            "rules"
          ],
          "additionalProperties": false,
          "description": "Markov-style rewrite rules on this buffer: each small match grid found on exact colors is replaced, in a seeded order, without overlapping rewrites. The region defaults to the whole canvas."
        }
      ]
    }
  }
