              ]
            },
            "remap": {
              "type": "object",
              "propertyNames": {
                "minLength": 1,
                "maxLength": 1
              },
              "additionalProperties": {
                "type": "string",
                "description": "Palette name, transparent, or #RGB/#RGBA/#RRGGBB/#RRGGBBAA."
              },
