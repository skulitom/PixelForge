            },
            "y": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "color": {
              "type": "string",
