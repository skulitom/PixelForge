{
  "name": "pixelforge-agent",
  "version": "0.4.4",
  "description": "Agent-first pixel art and animation toolkit with a CLI, MCP server and local studio. Deterministic JSON recipes to PNG, APNG and sprite atlases; zero dependencies.",
  "homepage": "https://github.com/skulitom/PixelForge#readme",
  "repository": { "type": "git", "url": "git+https://github.com/skulitom/PixelForge.git" },
  "bugs": { "url": "https://github.com/skulitom/PixelForge/issues" },
  "keywords": ["pixel-art", "pixelart", "sprites", "dithering", "particle-effects", "sprite-sheet", "sprite-animation", "texture-atlas", "game-assets", "gamedev", "mcp", "mcp-server", "model-context-protocol", "ai-agents", "agent-skills", "png", "apng", "gif", "cli", "zero-dependencies"],
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "bin": { "pixelforge": "./bin/pixelforge.js" },
  "exports": { ".": "./src/index.js", "./core": "./src/core.js", "./runtime": "./src/runtime.js", "./authoring": "./src/authoring.js", "./scene": "./src/scene.js", "./autotile": "./src/autotile.js", "./fx": "./src/fx.js", "./craft": "./src/craft.js", "./gif": "./src/gif.js" },
  "files": ["bin", "src", "studio", "examples", "schema.json", "poses.schema.json", "scene.schema.json", "autotile.schema.json", "fx.schema.json", "docs", "skills", "README.md", "AGENTS.md", "CONTRIBUTING.md", "llms.txt", "LICENSE"],
  "scripts": {
    "test": "node --test",
    "start": "node bin/pixelforge.js preview",
    "demo": "node bin/pixelforge.js render examples/forest-spirit.json --out output/forest-spirit",
    "play": "node scripts/serve-emberfall.mjs",
    "art:emberfall": "node scripts/build-emberfall.mjs --force",
    "stress:emberfall": "node scripts/stress-emberfall.mjs",
    "art:quality": "node scripts/build-quality-lab.mjs",
    "check:quality": "node scripts/build-quality-lab.mjs --check",
    "review:quality": "node bin/pixelforge.js preview examples/quality/hollow.scene.json",
    "play:tidewatch": "node scripts/serve-tidewatch.mjs",
    "art:tidewatch": "node showcase/tidewatch/tools/build-assets.mjs",
    "check:tidewatch": "node showcase/tidewatch/tools/build-assets.mjs --check",
    "mcp": "node bin/pixelforge.js mcp",
    "build:studio": "node scripts/build-studio.mjs",
    "check:studio": "node scripts/build-studio.mjs --check",
    "verify:studio": "node scripts/verify-studio.mjs",
    "qa:studio": "node scripts/qa-studio.mjs"
  }
}
