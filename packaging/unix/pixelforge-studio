#!/bin/sh
# Starts PixelForge Studio with the Node.js runtime in this folder. Press Ctrl+C or close the window to stop it.
self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in /*) self=$target ;; *) self=$(dirname "$self")/$target ;; esac
done
here=$(CDPATH= cd -- "$(dirname "$self")" && pwd -P) || exit 1
if [ ! -x "$here/runtime/node" ]; then
  echo "PixelForge Studio cannot find runtime/node next to this script." >&2
  echo "Extract the whole archive first and keep its contents together." >&2
  exit 1
fi
exec "$here/runtime/node" "$here/launcher/studio.mjs" "$@"
